# Copy this file to .env (git-ignored) and fill it in. Never commit real keys.

# Needed only for `npm run ep -- voice <id>` and `npm run audio:sfx` (they spend ElevenLabs credits).
ELEVENLABS_API_KEY=

# Optional: default narrator voice (an ElevenLabs voice id). Falls back to brand.json.
ELEVENLABS_VOICE_ID=

# Optional: a voice per language, used when an episode declares "lang". Example for Indonesian:
# ELEVENLABS_VOICE_ID_ID=
# Priority: episode.json "voice.voiceId" > ELEVENLABS_VOICE_ID_<LANG> > ELEVENLABS_VOICE_ID > brand.json
