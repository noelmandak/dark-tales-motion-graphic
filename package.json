{
  "name": "dark-tales",
  "version": "0.1.0",
  "description": "Data-driven motion-graphics engine for short-form \"dark true story\" videos: write an episode as JSON, get a vertical video with word-synced subtitles, voice-over and sound design.",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.538",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "lint": "eslint src && tsc",
    "typecheck": "tsc --noEmit",
    "ep": "node scripts/episode.mjs",
    "ep:lint": "node scripts/episode.mjs lint all",
    "audio:sfx": "node scripts/generate-audio.mjs sfx",
    "audio:bgm": "node scripts/make-bgm.mjs",
    "upgrade": "remotion upgrade",
    "assets": "node scripts/collage-assets.mjs"
  },
  "allowScripts": {
    "esbuild": false
  },
  "author": "Noel Christevent Mandak",
  "keywords": [
    "remotion",
    "motion-graphics",
    "short-form-video",
    "ugc",
    "storytelling",
    "elevenlabs",
    "typescript",
    "video-generation"
  ]
}
