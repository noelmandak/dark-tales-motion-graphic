  "meta": {
    "title": "The Day a Wave of Beer Flooded London (True Story)",
    "description": "In 1814 a giant brewery vat burst in London and sent a wave of porter into the slums. Who paid for the deaths, and which parts of the story are legend?",
    "hashtags": [
      "#darkhistory",
      "#truestory",
      "#history",
      "#london",
      "#animatedhistory",
      "#shorts"
    ],
    "sources": [
      {
        "claim": "On 17 Oct 1814, at about 4:30 pm, a vat at Meux & Co's Horse Shoe Brewery (Tottenham Court Road / Oxford Street) burst after a hoop slipped; the vat was about 22 feet tall",
        "source": "Wikipedia, 'London Beer Flood'; City AM, 'On this day in 1814' (search summary); Historic UK, 'The London Beer Flood of 1814' (search summary)",
        "verified": true,
        "note": "Wikipedia article read in full; City AM and Historic UK seen only as search summaries, which agree on date and hoop."
      },
      {
        "claim": "A clerk noticed the slipped hoop and was reportedly told no harm would ensue",
        "source": "Wikipedia, 'London Beer Flood' (George Crick, storehouse clerk)",
        "verified": false,
        "note": "Single source; narration says 'Reportedly'."
      },
      {
        "claim": "Volume released: sources disagree, 128,000 to 323,000 imperial gallons; narration says 'at least a hundred thousand'",
        "source": "Wikipedia, 'London Beer Flood'; Historic UK (over 320,000 gallons)",
        "verified": true,
        "note": "Narration says 'accounts differ'."
      },
      {
        "claim": "A wave about 15 feet high swept into the St Giles rookery (New Street), destroying two houses",
        "source": "Wikipedia, 'London Beer Flood'",
        "verified": false,
        "note": "Single source for the 15 ft figure; narration says 'reportedly'. Narration says 'houses' (plural) were brought down; Wikipedia says two destroyed, two damaged."
      },
      {
        "claim": "Eight people died, all women and children; some were mourners at a wake for a two-year-old boy",
        "source": "Wikipedia, 'London Beer Flood' (list of eight victims, five at the wake); City AM and Old Salt Blog (search summaries: eight dead, women and children); Historic UK says four mourners",
        "verified": true,
        "note": "Mourner count differs by source, so narration says only 'some'."
      },
      {
        "claim": "Inquest jury ruled the deaths accidental, 'by misfortune'; the brewery paid no compensation",
        "source": "Wikipedia, 'London Beer Flood' (verdict 'casually, accidentally and by misfortune'; 'act of God'; no compensation); City AM (search summary: coroner's wording; Meux not held liable)",
        "verified": true
      },
      {
        "claim": "The brewery reportedly petitioned Parliament and recovered part of its excise duty",
        "source": "Wikipedia, 'London Beer Flood' (about £7,250 from HM Excise after a private petition); The Drinks Business and other accounts (search summaries: brewery petitioned Parliament to reclaim excise duty on the lost beer)",
        "verified": true,
        "note": "Amounts differ between sources (about 7,000 to 7,250 pounds), so the narration gives no figure and says 'Reportedly'."
      },
      {
        "claim": "Stories of mass drinking and a later death from it are not found in contemporary newspapers; large wooden vats were later phased out",
        "source": "Wikipedia, 'London Beer Flood' (citing brewing historian Martyn Cornell)",
        "verified": false,
        "note": "Single source; Cornell's blog not read directly."
      }
    ]
  }
}
