  "meta": {
    "title": "The Pope Who Put a Corpse on Trial (True Story)",
    "description": "In 897, a pope had a dead pope dug up and put on trial. What happened next, and how the verdict was reversed, restored and argued over for years.",
    "hashtags": [
      "#darkhistory",
      "#truestory",
      "#history",
      "#medievalhistory",
      "#animatedhistory",
      "#shorts"
    ],
    "sources": [
      {
        "claim": "In early 897 Pope Stephen VI had Formosus's corpse exhumed and put on trial at a synod in Rome",
        "source": "Wikipedia, 'Cadaver Synod'; National Geographic, 'Vatican dead pope on trial'; Catholic Encyclopedia, 'Pope Formosus'",
        "verified": true,
        "note": "Date is 'probably January 897'; narration says only '897'."
      },
      {
        "claim": "Charge: he had broken church law to become pope; corpse propped on a throne; a deacon appointed to speak for it",
        "source": "Wikipedia, 'Cadaver Synod'; National Geographic; Catholic Encyclopedia (throne)",
        "verified": true
      },
      {
        "claim": "Verdict guilty; three fingers of the right hand cut off; body thrown into the Tiber",
        "source": "Wikipedia, 'Cadaver Synod'; National Geographic; Catholic Encyclopedia",
        "verified": true,
        "note": "Narration uses 'Reportedly'. The Tiber detail is flagged [citation needed] on Wikipedia; all three sources report it. The fisherman rescue story is legend: not used."
      },
      {
        "claim": "Stephen VI was arrested and strangled in prison within months (July/August 897)",
        "source": "Wikipedia, 'Cadaver Synod'; National Geographic",
        "verified": true,
        "note": "Narration says 'within months' and does not give a date."
      },
      {
        "claim": "The verdict was overturned, Formosus reburied in St. Peter's, trials of dead popes banned",
        "source": "Wikipedia, 'Cadaver Synod' (Theodore II 897, John IX 898); National Geographic (John IX); Catholic Encyclopedia",
        "verified": true,
        "note": "Sources differ on which pope and exact year, so the narration names no one and gives no date."
      },
      {
        "claim": "Years later Pope Sergius III reapproved the verdict (and required re-ordination of clergy ordained by Formosus)",
        "source": "Wikipedia, 'Pope Formosus'; Catholic Encyclopedia, 'Pope Formosus'",
        "verified": true,
        "note": "No year stated in narration (Sergius III's pontificate began 904)."
      },
      {
        "claim": "The best-known account of the trial (Liutprand of Cremona) was written decades later and is considered partisan, so some details may be exaggerated",
        "source": "Encyclopedia.com, 'Liutprand of Cremona' (Antapodosis written 955-962; 'drastic distortions' from hostility); Wikipedia, 'Pope Formosus' (historians think the account likely exaggerates); Medievalists.net, 'The Cadaver Synod' (Liutprand the only chronicler named for the trial's content)",
        "verified": true,
        "note": "Narration says 'best-known' rather than 'only': shorter contemporary mentions exist (e.g. Annales Alamannici; acts of the 898 synods). Not claimed: any specific detail is false."
      }
    ]
  }
}