      "id": "s2",
      "vo": "Jenazah itu adalah Paus Formosus. Para musuhnya menuduh dia melanggar hukum gereja untuk menjadi paus. Maka tubuhnya didudukkan di atas takhta di ruang sidang, dan seorang diakon ditunjuk untuk berbicara mewakili sang mati.",
      "shots": [
        {"at": 0, "type": "folio", "chapter": "II · TUDUHAN", "bg": "plain", "art": [{"kind": "medallion", "x": 540, "y": 700, "s": 1.15, "robe": "white", "name": "FORMOSUS"}]},
        {"at": "@musuhnya -0.1", "type": "folio", "chapter": "II · TUDUHAN", "bg": "arcade",
