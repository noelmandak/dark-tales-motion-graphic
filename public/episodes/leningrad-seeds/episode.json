  "meta": {
    "title": "The Scientists Who Starved Rather Than Eat the Seeds (True Story)",
    "description": "During the Siege of Leningrad, scientists guarded one of the world's largest seed collections and refused to eat it while the city starved. A true story of sacrifice, and of the man who built the collection.",
    "hashtags": [
      "#darkhistory",
      "#truestory",
      "#worldwar2",
      "#history",
      "#animatedhistory",
      "#shorts"
    ],
    "sources": [
      {
        "claim": "The Siege of Leningrad lasted from September 1941 to 1944 and the city was starving",
        "source": "Hyperallergic, 'Seeds of the Earth: the Vavilov Institute' (Sept 1941 - Jan 1944); Wikipedia, 'Nikolai Vavilov' (end of siege 'spring of 1944')",
        "verified": true,
        "note": "Sources give slightly different end dates; narration says only '1944'."
      },
      {
        "claim": "The Vavilov institute held hundreds of thousands of seed samples, one of the largest collections in the world",
        "source": "Wikipedia, 'Nikolai Vavilov' (250,000, 'the world's largest seedbank' at the time); Hyperallergic (about 325,250 samples today); Gulf News (345,000 varieties); Russia Beyond (370,000 seeds)",
        "verified": true,
        "note": "Counts vary by source and date, so narration says 'hundreds of thousands'. 'One of the largest' is hedged; Wikipedia says 'the largest' at the time."
      },
      {
        "claim": "The staff barricaded themselves in with the collection and took turns guarding it",
        "source": "Wikipedia, 'Nikolai Vavilov' (took shifts protecting the seeds); Russia Beyond ('barricaded themselves inside their vaults'); Atlas Obscura (rotating guard shifts, via search summary)",
        "verified": true
      },
      {
        "claim": "The staff did not eat the grain, which could have saved them",
        "source": "Wikipedia, 'Nikolai Vavilov' ('refused to eat its contents'); Hyperallergic ('did not eat the grains that could have saved them'); Gulf News (died 'despite having access to the grain')",
        "verified": true
      },
      {
        "claim": "Some of the scientists starved to death while guarding the collection",
        "source": "Wikipedia, 'Nikolai Vavilov' ('a number of them had died of starvation'); Hyperallergic (nine); Gulf News (28 employees died of hunger); Russia Beyond (a dozen)",
        "verified": true,
        "note": "The count is disputed (9, a dozen, 28), so NO number is used in the narration. Do not add one."
      },
      {
        "claim": "Nikolai Vavilov built the collection, was arrested in 1940 accused of spying, and died in prison in 1943",
        "source": "Wikipedia, 'Nikolai Vavilov' (arrested by the NKVD August 1940, accused of spying for the British and ruining Soviet agriculture; died in prison in Saratov 26 January 1943); Hyperallergic (arrested 6 August 1940, died in prison 1943)",
        "verified": true,
        "note": "Cause of death is disputed (starvation, pneumonia, heart failure); the narration gives none."
      },
      {
        "claim": "The collection survived the siege and the institute still exists in Saint Petersburg",
        "source": "Hyperallergic ('the institute survives in Saint Petersburg'); Gulf News (the institute's collection of 345,000 varieties); Wikipedia, 'Nikolai Vavilov'",
        "verified": true
      }
    ]
  }
}