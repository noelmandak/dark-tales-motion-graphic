  "meta": {
    "title": "The Town That Hunted a Phantom Gasser (True Story)",
    "description": "In 1944, a whole Illinois town hunted a mysterious gasser. Police found nothing, and the reports stopped after one announcement. What was really going on?",
    "hashtags": [
      "#darkhistory",
      "#truestory",
      "#history",
      "#mystery",
      "#illinois",
      "#shorts"
    ],
    "sources": [
      {
        "claim": "In late Aug / early Sept 1944 in Mattoon, Illinois, residents reported strange odors and symptoms; the first case in the media was Aline Kearney's on 1 September",
        "source": "Wikipedia, 'Mad Gasser of Mattoon' (read in full); Atlas Obscura, Damn Interesting, PopSci (search summaries)",
        "verified": true,
        "note": "Sources differ on the first call (31 Aug vs 1 Sept) and on details of the Kearney family; narration says only 'September 1944' and 'a woman'."
      },
      {
        "claim": "Victims reported strange odors, nausea, weakness and partial paralysis of the legs; no one died or had serious lasting effects",
        "source": "Wikipedia, 'Mad Gasser of Mattoon'; search summaries (Atlas Obscura, Skeptoid, PopSci)",
        "verified": true
      },
      {
        "claim": "The local paper treated the accounts as fact",
        "source": "Wikipedia, 'Mad Gasser of Mattoon' (Mattoon Journal-Gazette headlines)",
        "verified": true,
        "note": "Exact headline wording differs between sources and is not quoted."
      },
      {
        "claim": "More than two dozen cases were reported to police over about two weeks",
        "source": "Wikipedia, 'Mad Gasser of Mattoon'; Skeptic / Damn Interesting (search summaries)",
        "verified": true,
        "note": "Wikipedia's case table is marked incomplete."
      },
      {
        "claim": "Armed citizens patrolled; police told patrol groups to disband and urged restraint with firearms",
        "source": "Wikipedia, 'Mad Gasser of Mattoon'; popular retellings mention armed patrols",
        "verified": true
      },
      {
        "claim": "A cloth was found on the Cordes porch; Beulah Cordes became violently ill after sniffing it; analysis found no chemicals that explained her reaction",
        "source": "Wikipedia, 'Mad Gasser of Mattoon'; Atlas Obscura (search summary)",
        "verified": true,
        "note": "Wikipedia says 'authorities analyzed the cloth'; narration says 'the lab'."
